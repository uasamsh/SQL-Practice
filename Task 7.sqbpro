table><table schema="main" name="V_CustomerInvoices" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="78"/><column index="2" value="101"/><column index="3" value="62"/><column index="4" value="156"/><column index="5" value="156"/><column index="6" value="62"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="V_EmployeeDirectory" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="74"/><column index="2" value="132"/><column index="3" value="156"/><column index="4" value="85"/><column index="5" value="195"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="V_TracksInvoiceLine" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="62"/><column index="2" value="59"/><column index="3" value="56"/><column index="4" value="187"/><column index="5" value="257"/><column index="6" value="76"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 10">
 -- Edit views 
-- Now we can use VIEW to join and save tables like V_CustomerInvoices 

-- Description: Create a view that combines customer names with their invoice details using an INNER JOIN.

CREATE VIEW V_CustomerInvoices AS
SELECT 
    c.CustomerId,
    c.FirstName,
    c.LastName,
    i.InvoiceId,
    i.InvoiceDate,
    i.BillingCity,
    i.Total
FROM Invoice AS i
INNER JOIN Customer AS c
 ON i.CustomerId = c.CustomerId;
 
 
-- Description: Retrieve all customer invoice records for New York from the saved view. 
 SELECT *
 FROM V_CustomerInvoices
 WHERE BillingCity = 'New York'
 
-- JOINS views V_CustomerInvoices and 
 -- Description: Create a view that joins invoice line items with track details using an INNER JOIN and deleting VIEW.
 CREATE VIEW V_TracksInvoiceLine AS
SELECT
    il.InvoiceId,
    il.UnitPrice,
    il.Quantity,
    t.Name,
    t.Composer,
    t.Milliseconds
FROM
    InvoiceLine AS il
INNER JOIN
    Track AS t
ON
    il.TrackId = t.TrackId;
	
-- 1st Method Description: Join four tables (Customer, Invoice, InvoiceLine, and Track) to view customer purchases with track names.

SELECT 
    c.FirstName,
    c.LastName,
    i.InvoiceDate,
    t.Name AS TrackName,
    il.UnitPrice
FROM Customer c
INNER JOIN Invoice i 
    ON c.CustomerId = i.CustomerId
INNER JOIN InvoiceLine il 
    ON i.InvoiceId = il.InvoiceId
INNER JOIN Track t 
    ON il.TrackId = t.TrackId;
	
	
-- 	
--2nd Method Description: Retrieve specific invoice and track columns,  FROM the V_TracksInvoiceLine VIEW Created for join 3 tables.
-- Description: Query specific columns directly from the saved V_TracksInvoiceLine virtual table (view) without repeating the JOIN.
SELECT
    InvoiceId,
    UnitPrice,
    Quantity,
    Name
FROM
    V_TracksInvoiceLine;
SELECT
    tl.InvoiceId,
    tl.UnitPrice,
    tl.Quantity,
    tl.Name,
	i.BillingAddress,
	i.Total
FROM
    V_TracksInvoiceLine AS tl
INNER JOIN
 Invoice AS i
 ON tl.InvoiceId = i.InvoiceId
 
 -- DELETE views 
 -- DROP VIEW IF EXISTS &quot;main&quot;.&quot;V_AvgTotal&quot;;
 
 DROP VIEW V_AvgTotal -- Now execute/RUN this query to DELETE view
 
	</sql><sql name="Edit View V_AvgTotal">DROP VIEW IF EXISTS &quot;main&quot;.&quot;V_AvgTotal&quot;;
CREATE VIEW V_AvgTotal AS
SELECT
 AVG(Total)AS [Average TOTAL]
 FROM
 Invoice</sql><sql name="Task 7">/*  # The Music Company – Employee Directory View

The Music Company's HR department regularly needs employee information for different reports. This includes employee names, job titles, cities, and email addresses.

Instead of writing the same SQL query every time, the company wants to create a reusable **SQL View** that stores the employee directory query.

The task is to create this view and then retrieve its records.

## Your Task

Write two SQL statements:

1. **CREATE VIEW:** Create a view that displays employee directory information.
2. **SELECT:** Retrieve employee records from the saved view.

## Expected Result

The view should display **8 rows and 5 columns**.

- **EmployeeId:** The unique ID assigned to each employee.
- **FullName:** The employee's first and last name combined with a space.
- **Title:** The employee's job position.
- **City:** The city where the employee works.
- **Email:** The employee's email address.

## Requirements

1. Create a view named `V_EmployeeDirectory`.
2. Combine `FirstName` and `LastName` using `||` with a space between them.
3. Retrieve employee details from the `Employee` table.
4. Sort employee records alphabetically by `LastName` within the view.
5. After creating the view, use `SELECT * FROM V_EmployeeDirectory` to display the records.
6. Add a short SQL comment explaining the purpose of the query.

## Guidelines and Helpful Tips

- **Source table:** `Employee`
- **Required fields:** `EmployeeId`, `FirstName`, `LastName`, `Title`, `City`, `Email`
- **Full name format:** `FirstName || ' ' || LastName AS FullName`
- **View creation:** Use `CREATE VIEW V_EmployeeDirectory AS SELECT ...`
- **Expected result:** 8 employee records.

Once the view has been created, run the following statement to see its contents:

`SELECT * FROM V_EmployeeDirectory;`

## Expected Output

| EmployeeId | FullName | Title | City | Email |
|:---:|:---|:---|:---|:---|
| 1 | Andrew Adams | General Manager | Edmonton | andrew@chinookcorp.com |
| 8 | Laura Callahan | IT Staff | Lethbridge | laura@chinookcorp.com |
| 2 | Nancy Edwards | Sales Manager | Calgary | nancy@chinookcorp.com |
| 5 | Steve Johnson | Sales Support Agent | Calgary | steve@chinookcorp.com |
| 7 | Robert King | IT Staff | Lethbridge | robert@chinookcorp.com |
| 6 | Michael Mitchell | IT Manager | Calgary | michael@chinookcorp.com |
| 4 | Margaret Park | Sales Support Agent | Calgary | margaret@chinookcorp.com |
| 3 | Jane Peacock | Sales Support Agent | Calgary | jane@chinookcorp.com |

**Total Results:** 8 rows and 5 columns.

**Sorting:** Employee records are arranged alphabetically by their last names.
*/

CREATE VIEW V_EmployeeDirectory AS
SELECT
    EmployeeId,
    FirstName ||' '|| LastName AS FullName,
    Title,
    City,
    Email

FROM Employee

ORDER BY LastName;

-- Now query the view
SELECT * FROM V_EmployeeDirectory;</sql><current_tab id="2"/></tab_sql></sqlb_project>
